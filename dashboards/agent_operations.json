        "current": { "selected": true, "text": "utility-cluster", "value": "ec573432-9867-4970-ba22-44f36e42b218" },
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus Data Source"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "FortiGate Agent Operations & Telemetry",
