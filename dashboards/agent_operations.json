{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Loki Poller Freshness",
      "description": "Seconds since last successful Loki query batch. Critical if > 3x poll interval.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "forti_loki_last_success_age_seconds",
          "legendFormat": "Loki Age (s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Model Inference Freshness",
      "description": "Seconds since last successful Qwen structured investigation.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "forti_model_last_success_age_seconds",
          "legendFormat": "Model Age (s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 180 },
              { "color": "red", "value": 600 }
            ]
          },
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Event Backlog (Pending)",
      "description": "Normalized events currently awaiting episode correlation processing.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "forti_backlog_pending_events",
          "legendFormat": "Pending Events",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Dead-Letter Outbox Alerts",
      "description": "Outbox notifications moved to DEAD_LETTER after permanent failure.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "forti_outbox_dead_letter_total",
          "legendFormat": "Dead Letters",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 5,
      "title": "Raw Logs Fetched vs Normalized Ingest Rate",
      "description": "Rate of raw Loki log lines processed vs filtered security events inserted.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(forti_poller_raw_lines_total[1m])",
          "legendFormat": "Raw Lines/sec",
          "refId": "A"
        },
        {
          "expr": "rate(forti_poller_normalized_events_total[1m])",
          "legendFormat": "Normalized Events/sec",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "id": 6,
      "title": "Active Incident Episodes in Memory",
      "description": "Currently active security attack episodes maintained within correlation windows.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "forti_incidents_active_count",
          "legendFormat": "Active Episodes",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 7,
      "title": "Google Chat Outbox Delivery & Retry Status",
      "description": "Delivery throughput vs webhook transmission errors.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(forti_outbox_delivered_total[1m])",
          "legendFormat": "Delivered Alerts/sec",
          "refId": "A"
        },
        {
          "expr": "rate(forti_outbox_failures_total[1m])",
          "legendFormat": "Delivery Failures/sec",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 8,
      "title": "Loki Poller Query Latency (p95 / p50)",
      "description": "Distribution of LogQL poll query latencies against Loki read endpoint.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(forti_poller_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 Duration (s)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(forti_poller_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 Duration (s)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 9,
      "title": "Local Qwen Investigation Latency & Rate Limits",
      "description": "Model inference duration and concurrency rate-limit / circuit breaker events.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(forti_model_inference_duration_seconds_sum[5m]) / clamp_min(rate(forti_model_inference_duration_seconds_count[5m]), 0.001)",
          "legendFormat": "Average Latency (s)",
          "refId": "A"
        },
        {
          "expr": "rate(forti_model_failures_total[5m])",
          "legendFormat": "Inference Failures/sec",
          "refId": "B"
        },
        {
          "expr": "rate(forti_investigations_rate_limited_total[5m])",
          "legendFormat": "Rate Limited/sec",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 10,
      "title": "ADK Agent Investigator (shadow / adk modes)",
      "type": "row",
      "panels": []
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "id": 11,
      "title": "Agent Runs by Mode and Outcome",
      "description": "ADK investigation runs per second by mode (shadow, live) and outcome (VALID, REJECTED, BUDGET_EXHAUSTED, TIMEOUT, SCHEMA_INVALID, ERROR).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (mode, outcome) (rate(forti_agent_runs_total[5m]))",
          "legendFormat": "{{mode}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "id": 12,
      "title": "Agent Run Duration (p95 / p50)",
      "description": "Wall-clock duration of one whole ADK investigation (bounded by AGENT_TIMEOUT_SECONDS).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(forti_agent_run_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 Duration (s)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(forti_agent_run_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 Duration (s)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "id": 13,
      "title": "Budget-Exhausted Runs (24 h)",
      "description": "Runs stopped by the AGENT_MAX_LLM_CALLS ceiling in the last 24 hours.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "increase(forti_agent_budget_exhausted_total[24h])",
          "legendFormat": "Budget exhausted",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "id": 14,
      "title": "Model Calls by Agent",
      "description": "Model calls per second by agent (incident_investigator, evidence_agent, context_agent, assessment_writer).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (agent) (rate(forti_agent_llm_calls_total[5m]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 31 },
      "id": 15,
      "title": "Tool Calls by Tool and Outcome",
      "description": "Read-only tool calls per second by tool and outcome (success, refused, error). Refused lookup_asset calls mean the agent is guessing IPs.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (tool, outcome) (rate(forti_agent_tool_calls_total[5m]))",
          "legendFormat": "{{tool}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
      "id": 16,
      "title": "Agent Tokens",
      "description": "Tokens per second reported by the model endpoint for agent calls, by direction.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (direction) (rate(forti_agent_tokens_total[5m]))",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["fortigate", "agent-ops", "monitoring"],
  "templating": {
    "list": [
