# FortiGate Intelligence Service Environment Configuration

# Database (PostgreSQL 16)
POSTGRES_USER=forti_intel
POSTGRES_PASSWORD=<set-me>
POSTGRES_DB=forti_intelligence
DATABASE_URL=postgresql://forti_intel:<set-me>@postgres:5432/forti_intelligence

# Loki Ingestion Gateway
LOKI_BASE_URL=https://loki.example.internal/loki/api/v1/query_range
LOKI_USER=ai-agent
LOKI_PASSWORD=<set-me>
LOKI_SELECTOR={service_name="forticlient"}
LOKI_TLS_VERIFY=true
LOKI_QUERY_TIMEOUT_SECONDS=15
LOKI_POLL_INTERVAL_SECONDS=15
LOKI_REPLAY_OVERLAP_SECONDS=120
LOKI_SLICE_SECONDS=30
LOKI_MAX_ENTRIES_PER_QUERY=1000

# Local Qwen Investigation Model (vLLM Serving)
LLM_ENABLED=true
LLM_BASE_URL=http://vllm.example.internal:8000/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=EMPTY
LLM_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_TOKENS=12000
LLM_MAX_OUTPUT_TOKENS=3500

# Google Chat Alerting
GCHAT_WEBHOOK_URL=
GCHAT_DRY_RUN=true
GCHAT_RATE_LIMIT_DELAY_SECONDS=2.0
GCHAT_THREAD_BY_INCIDENT=true

# Grafana Links (for alert drill-down)
GRAFANA_BASE_URL=https://grafana.example.internal
GRAFANA_DATASOURCE_UID=<grafana-loki-datasource-uid>

# Service Operations
LOG_LEVEL=INFO
METRICS_PORT=8085
